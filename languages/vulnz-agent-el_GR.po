#. Description of the plugin
#: vulnz-agent.php
msgid "A companion WordPress plugin for the Vulnz project that syncs site data with the Vulnz API."
msgstr "Ένα συμπληρωματικό πρόσθετο WordPress για το έργο Vulnz, το οποίο συγχρονίζει τα δεδομένα του ιστότοπου με το API του Vulnz."

#. Author of the plugin
#: vulnz-agent.php
msgid "Paul Faulkner"
msgstr "Πολ Φόλκνερ"

#. Author URI of the plugin
#: vulnz-agent.php
msgid "https://headwall-hosting.com/"
msgstr "https://headwall-hosting.com/"

